# Copy this file to routes.toml and edit to match your To-Do lists.
# Rules are evaluated top-to-bottom; the first match wins.
# Both `list` and `title_match` are optional — omit either to match all values for that field.

# --- Example rules ---

# All tasks in the "Coding" list → dispatch with the "default" profile
[[routes]]
list = "Coding"
profile = "default"
cwd = "/path/to/your/dev/dir"   # CHANGE ME: absolute path to your project root

# Pull-request review tasks (title contains "PR") → pr-reviewer profile
# [[routes]]
# title_match = "(?i)\\bPR\\b"
# profile = "pr-reviewer"
# cwd = "/path/to/your/dev/dir"

# Planner-linked tasks only (cross-team project work)
# [[routes]]
# source = "planner"
# profile = "default"
# cwd = "/path/to/your/dev/dir"

# Tasks from a specific list with a keyword filter
# [[routes]]
# list = "Work"
# title_match = "(?i)deploy"
# profile = "default"
# cwd = "/path/to/your/infra/dir"

# --- Fallback behaviour for unmatched tasks ---
[default]
unmatched_action = "llm_fallback"   # "llm_fallback" | "skip" | "default_profile"
fallback_profile = "example"
fallback_cwd = "/tmp"
